parameters:
    level: 6
    # Die Seiten laufen im Gueltigkeitsbereich von public/index.php und finden
    # dort $kern vor; sie kuendigen das mit "@var Kern $kern" an.
    paths:
        - app
        - seiten
        - bin
        - bootstrap.php
        - public/index.php
    excludePaths:
        - vendor
