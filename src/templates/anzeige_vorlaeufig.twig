{% extends "oeffentlich.twig" %}

{# Platzhalter bis Phase 4: dann steht hier der Health-Balken. #}

{% block titel %}{{ klasse.anzeigename }} · Klassenziel{% endblock %}

{% block inhalt %}
<section class="karte">
    <p class="ueberzeile">{{ klasse.anzeigename }} · Schuljahr {{ klasse.schuljahr }}</p>
    <h1>Unser Ziel: {{ klasse.belohnung }}</h1>
    <p class="leise">Der Punktestand erscheint hier, sobald die ersten Einträge aus dem Klassenbuch eingelesen sind.</p>
</section>
{% endblock %}
