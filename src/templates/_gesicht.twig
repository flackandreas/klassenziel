{#
  Ein Smiley je Stufe (Stimmung.php): 0 besorgt, 1 neutral, 2 laechelnd,
  3 strahlend, 4 Jubel mit Sternaugen. Selbst gezeichnet statt Emoji: sieht
  auf dem Beamer-PC und jedem Handy gleich aus und laedt keine Schrift nach.

  Farben nur ueber Klassen (CSP), die stehen in anzeige.css.

  lage {x, y, groesse} setzt das Gesicht innerhalb einer anderen Grafik an
  eine Stelle (Etappen neben der Verlaufslinie).
#}
{% macro gesicht(stufe, klasse = '', lage = null) %}
<svg class="gesicht{% if klasse %} {{ klasse }}{% endif %}" viewBox="0 0 40 40"{% if lage %} x="{{ lage.x }}" y="{{ lage.y }}" width="{{ lage.groesse }}" height="{{ lage.groesse }}"{% endif %} aria-hidden="true" focusable="false">
    <circle class="gesicht__kopf" cx="20" cy="20" r="18"/>
{% if stufe == 0 %}
    <path class="gesicht__linie" d="M11.5 12.5 L16.5 10.5 M28.5 12.5 L23.5 10.5"/>
    <circle class="gesicht__fleck" cx="14" cy="17" r="2.4"/>
    <circle class="gesicht__fleck" cx="26" cy="17" r="2.4"/>
    <path class="gesicht__linie" d="M13.5 29 Q20 24 26.5 29"/>
{% elseif stufe == 1 %}
    <circle class="gesicht__fleck" cx="14" cy="16" r="2.4"/>
    <circle class="gesicht__fleck" cx="26" cy="16" r="2.4"/>
    <path class="gesicht__linie" d="M14 27 L26 27"/>
{% elseif stufe == 2 %}
    <circle class="gesicht__fleck" cx="14" cy="16" r="2.4"/>
    <circle class="gesicht__fleck" cx="26" cy="16" r="2.4"/>
    <path class="gesicht__linie" d="M12.5 24.5 Q20 31.5 27.5 24.5"/>
{% elseif stufe == 3 %}
    <path class="gesicht__linie" d="M10.5 17 Q14 12.5 17.5 17 M22.5 17 Q26 12.5 29.5 17"/>
    <path class="gesicht__fleck" d="M11.5 23 Q20 35 28.5 23 Z"/>
{% else %}
    <polygon class="gesicht__fleck" points="14.0,11.0 15.2,14.3 18.8,14.5 16.0,16.6 16.9,20.0 14.0,18.1 11.1,20.0 12.0,16.6 9.2,14.5 12.8,14.3"/>
    <polygon class="gesicht__fleck" points="26.0,11.0 27.2,14.3 30.8,14.5 28.0,16.6 28.9,20.0 26.0,18.1 23.1,20.0 24.0,16.6 21.2,14.5 24.8,14.3"/>
    <path class="gesicht__fleck" d="M10.5 23 Q20 36.5 29.5 23 Z"/>
{% endif %}
</svg>
{% endmacro %}
