{% extends "grundlage.twig" %}

{% block titel %}Vorgaben{% endblock %}

{% set auswahlen = [
    {'wert': 'pruefen', 'name': 'in die Prüfliste (nicht zugeordnet)'},
    {'wert': 'negativ:klein', 'name': 'negativ, klein'},
    {'wert': 'negativ:mittel', 'name': 'negativ, mittel'},
    {'wert': 'negativ:gross', 'name': 'negativ, groß'},
    {'wert': 'positiv:klein', 'name': 'positiv, klein'},
    {'wert': 'positiv:mittel', 'name': 'positiv, mittel'},
    {'wert': 'positiv:gross', 'name': 'positiv, groß'},
    {'wert': 'neutral', 'name': 'neutral (zählt nicht)'}
] %}

{% block inhalt %}
<p class="brotkrumen"><a href="/">Meine Klassen</a> › <a href="/verwaltung">Einstellungen</a> › Vorgaben</p>
<h1>Vorgaben der Schule</h1>

<form class="karte" method="post" action="/verwaltung/vorgaben" novalidate>
    <h2>Startwerte für neue Klassen</h2>
    <p class="leise">Werden beim Anlegen einer Klasse übernommen. Laufende Klassen behalten ihre Werte – ein Wettbewerb soll sich nicht von außen ändern.</p>
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="formular-raster formular-raster--schmal">
        {% for feld, name in {'klein': 'klein', 'mittel': 'mittel', 'gross': 'groß', 'wochenbonus': 'Wochenbonus'} %}
        <div class="feld{% if fehler[feld] is defined %} feld--fehler{% endif %}">
            <label for="v-{{ feld }}">{{ name }}</label>
            <input id="v-{{ feld }}" name="{{ feld }}" type="number" min="0" max="20" step="1" inputmode="numeric" value="{{ eingabe[feld] }}">
            {% if fehler[feld] is defined %}<p class="feld__fehler">{{ fehler[feld] }}</p>{% endif %}
        </div>
        {% endfor %}
    </div>
    <div class="aktionen"><button class="knopf" type="submit" name="aktion" value="punkte">Speichern</button></div>
</form>

<form class="karte" method="post" action="/verwaltung/vorgaben">
    <h2>WebUntis-Kategorien</h2>
    <p class="leise">Gilt für jede Klasse ohne eigene Zuordnung, auch rückwirkend. Neue Kategorien trägt der Import von selbst als „nicht zugeordnet“ ein –
       etwa, wenn die Schule in WebUntis eine Kategorie „Lob“ einführt.</p>
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="aktion" value="kategorien">
    <div class="tabelle-huelle">
    <table class="tabelle">
        <thead><tr><th>Kategorie</th><th>zählt als</th></tr></thead>
        <tbody>
        {% for k in kategorien %}
            {% set aktuell = k.richtung in ['positiv', 'negativ'] ? k.richtung ~ ':' ~ k.stufe : k.richtung %}
            <tr>
                <td><label for="kv-{{ loop.index }}">{{ k.webuntis_kategorie }}</label><input type="hidden" name="kategorie_name[{{ loop.index }}]" value="{{ k.webuntis_kategorie }}"></td>
                <td>
                    <select id="kv-{{ loop.index }}" name="kategorie[{{ loop.index }}]">
                        {% for a in auswahlen %}<option value="{{ a.wert }}"{% if aktuell == a.wert %} selected{% endif %}>{{ a.name }}</option>{% endfor %}
                    </select>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <div class="aktionen"><button class="knopf" type="submit">Speichern</button></div>
</form>
{% endblock %}
