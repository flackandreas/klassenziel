{% extends "grundlage.twig" %}

{% block titel %}{{ klasse.anzeigename }}{% endblock %}

{% block inhalt %}
<p class="brotkrumen"><a href="/">Meine Klassen</a> › {{ klasse.anzeigename }}</p>

<div class="seitenkopf">
    <div>
        <h1>{{ klasse.anzeigename }}</h1>
        <p class="leise">{{ klasse.exportKuerzel }} · Schuljahr {{ klasse.schuljahr }} · Ziel: {{ klasse.belohnung }}</p>
        <p class="leise">{% if klasse.datenstand %}Datenstand: Export vom {{ klasse.datenstand|date('d.m.Y, H:i') }} Uhr{% else %}Noch kein Export eingelesen.{% endif %}</p>
    </div>
    {% if not klasse.istArchiviert %}<a class="knopf" href="/import">Export einlesen</a>{% endif %}
</div>

{% if klasse.istArchiviert %}
<div class="meldung meldung--hinweis" role="status">
    Archiviert am {{ klasse.archiviertAm|date('d.m.Y') }}. Der Link gilt nicht mehr, die Originaltexte aus dem Klassenbuch sind gelöscht.
</div>
{% endif %}

<section class="karte" id="link" aria-labelledby="titel-link">
    <h2 id="titel-link">Link für Klasse und Eltern</h2>
    {% if link %}
        <p>Über diesen Link sehen Schülerinnen, Schüler und Eltern die Klassenseite – nur lesen, ohne Anmeldung, ohne Namen.
           Wer den Link hat, kommt hinein: Er gehört in den Elternbrief und an den Beamer, nicht in öffentliche Gruppen.</p>
        <div class="linkfeld">
            <input id="klassenlink" type="text" value="{{ link }}" readonly aria-label="Link zur Klassenseite">
            <button class="knopf knopf--zweit" type="button" data-kopieren="klassenlink" data-kopiert-text="Kopiert">Kopieren</button>
        </div>
        <p class="leise">
            <a href="{{ link }}" target="_blank" rel="noopener noreferrer">Seite öffnen</a> ·
            <a href="{{ link }}?ansicht=beamer" target="_blank" rel="noopener noreferrer">Beamer-Ansicht</a>
        </p>
        <form method="post" action="/klassen/{{ klasse.id }}" class="aktionen">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="aktion" value="link_neu">
            <button class="knopf knopf--warnung" type="submit">Neuen Link erzeugen</button>
            <span class="leise">Der bisherige Link gilt danach sofort nicht mehr – etwa, wenn er in die falschen Hände geraten ist.</span>
        </form>
    {% elseif not klasse.istArchiviert %}
        <p>Der Link lässt sich nicht anzeigen – vermutlich passt der Schlüssel nicht mehr zu den gespeicherten Daten. Ein neuer Link hilft:</p>
        <form method="post" action="/klassen/{{ klasse.id }}" class="aktionen">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="aktion" value="link_neu">
            <button class="knopf" type="submit">Neuen Link erzeugen</button>
        </form>
    {% else %}
        <p class="leise">Archivierte Klassen haben keinen Link mehr.</p>
    {% endif %}
</section>

<section class="karte" aria-labelledby="titel-angaben">
    <h2 id="titel-angaben">Angaben</h2>
    {% if klasse.istArchiviert %}
        <dl class="angaben">
            <dt>Beginn der Wertung</dt><dd>{{ klasse.startdatum|date('d.m.Y') }}</dd>
            <dt>Stichtag</dt><dd>{{ klasse.stichtag ? klasse.stichtag|date('d.m.Y') : '–' }}</dd>
            <dt>Startwert / Zielwert</dt><dd>{{ klasse.startwert }} / {{ klasse.zielwert }}</dd>
        </dl>
    {% else %}
    <form method="post" action="/klassen/{{ klasse.id }}" novalidate>
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <input type="hidden" name="aktion" value="speichern">
        {% include "_klasse_formular.twig" %}
        <div class="aktionen">
            <button class="knopf" type="submit">Speichern</button>
        </div>
    </form>
    {% endif %}
</section>

<section class="karte" id="zustaendig" aria-labelledby="titel-zustaendig">
    <h2 id="titel-zustaendig">Zuständig</h2>
    <ul class="schlichtliste">
    {% for person in zustaendige %}
        <li>
            {{ person.name }}
            {% if konto.istVerwaltung and zustaendige|length > 1 and not klasse.istArchiviert %}
            <form method="post" action="/klassen/{{ klasse.id }}" class="inline">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="aktion" value="zustaendig_weg">
                <input type="hidden" name="konto_id" value="{{ person.id }}">
                <button class="knopf-link" type="submit">entfernen</button>
            </form>
            {% endif %}
        </li>
    {% endfor %}
    </ul>
    {% if konto.istVerwaltung and not klasse.istArchiviert %}
        {% if weitere_konten is empty %}
            <p class="leise">Weitere Lehrkräfte lassen sich eintragen, sobald sie sich einmal bei Klassenziel angemeldet haben.</p>
        {% else %}
        <form method="post" action="/klassen/{{ klasse.id }}" class="aktionen">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="aktion" value="zustaendig_hinzu">
            <label for="neu-zustaendig" class="unsichtbar">Lehrkraft</label>
            <select id="neu-zustaendig" name="konto_id">
                {% for weitere in weitere_konten %}<option value="{{ weitere.id }}">{{ weitere.name }}</option>{% endfor %}
            </select>
            <button class="knopf knopf--zweit" type="submit">Als zuständig eintragen</button>
        </form>
        {% endif %}
    {% elseif not konto.istVerwaltung %}
        <p class="leise">Weitere Zuständige trägt die Verwaltung ein.</p>
    {% endif %}
</section>

{% if not klasse.istArchiviert %}
<section class="karte karte--gefahr" id="archivieren" aria-labelledby="titel-archivieren">
    <h2 id="titel-archivieren">Archivieren</h2>
    <p>Am Schuljahresende: Der Link gilt danach nicht mehr, und alle Originaltexte aus dem Klassenbuch werden gelöscht.
       Punktestand und freigegebene Kurztexte bleiben erhalten. Das lässt sich nicht rückgängig machen.</p>
    <form method="post" action="/klassen/{{ klasse.id }}" class="aktionen">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <input type="hidden" name="aktion" value="archivieren">
        <label for="archiv-bestaetigung">Zur Bestätigung das Kürzel <strong>{{ klasse.exportKuerzel }}</strong> eintippen</label>
        <input id="archiv-bestaetigung" name="bestaetigt" type="text" autocomplete="off" spellcheck="false" required>
        <button class="knopf knopf--gefahr" type="submit">Endgültig archivieren</button>
    </form>
</section>
{% endif %}
{% endblock %}
