# ---------------------------------------------------------------------------
# Klassenziel - Werte fuer docker-compose.yml (Entwicklung und Tests)
#
# Nach .env kopieren. .env gehoert nicht ins Repository.
# Im SchulOS-Verbund stehen dieselben Werte in der .env des Portals.
# ---------------------------------------------------------------------------

# Hauptschluessel, 32 Byte, base64. Erzeugen mit:
#   openssl rand -base64 32
#
# Aus ihm leitet Klassenziel getrennte Schluessel ab: fuer die verschluesselten
# Originaltexte, fuer die Fingerabdruecke der Exportzeilen und fuer die
# geheimen Links. Er gehoert in die Sicherung - geht er verloren, sind die
# Originaltexte unlesbar, alle Links muessen neu erzeugt werden, und der
# naechste Export liesse sich nicht mehr einlesen, ohne dass jeder Vorfall
# doppelt zaehlt. Klassenziel sperrt den Import in diesem Fall.
KLASSENZIEL_SCHLUESSEL=

# Port auf dem eigenen Rechner.
KLASSENZIEL_PORT=8893
APP_URL=http://localhost:8893

DB_PASS=entwicklung
DB_ROOT_PASS=entwicklung-root

# development: Twig ohne Zwischenspeicher. Im Betrieb production.
APP_ENV=development

# Vermittler, deren X-Forwarded-For ausgewertet werden darf (siehe Portal).
TRUSTED_PROXIES=

# --- Nur am Portal ---------------------------------------------------------
# Klassenziel hat keine eigene Anmeldung. Diese Werte setzt im Verbund die
# compose.yml des Portals; hier stehen sie nur zur Vollstaendigkeit.
#
# PORTAL_ISSUER=http://schulos.localhost:8090
# PORTAL_CLIENT_ID=modul-klassenziel
# PORTAL_CLIENT_SECRET=
# PORTAL_REDIRECT_URI=http://klassenziel.schulos.localhost:8090/sso/rueckweg
# PORTAL_INTERN=http://portal
# PORTAL_ADMIN_GRUPPEN=Schulleitung
# PORTAL_ZUGANG_GRUPPEN=Schulleitung,Kollegium,Referendare
